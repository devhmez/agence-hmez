{
  "name": "forma-studio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "check:launch": "node scripts/check-launch.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:performance": "node scripts/lighthouse.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:pages": "node scripts/pages.mjs deploy --project-name agence-hmez --branch main",
    "start:pages": "node scripts/pages.mjs dev --port 8788 -c wrangler.jsonc -c ../../dist/server/wrangler.json"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@upstash/ratelimit": "2.1.0",
    "@upstash/redis": "1.38.4",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "resend": "6.28.1",
    "vinext": "^1.0.0-beta.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "^1.56.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.1.0",
    "lighthouse": "13.4.1",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "5.0.1",
    "wrangler": "^4.135.0"
  },
  "type": "module"
}
