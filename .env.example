# Canonical URL; replace for a real deployment. Never commit secret values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false for previews. Set true only after legal/business review and launch checks.
PUBLIC_LAUNCH_READY=false
# local works only in development/test, never next start or Vercel.
# Use resend for actual delivery; leaving this unset fails closed.
MAIL_MODE=local
RESEND_API_KEY=
# A verified Resend sender address, optionally Name <address>.
RESEND_FROM_EMAIL=
ENQUIRY_TO_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random server-only secret, minimum 32 characters; generate with openssl rand -hex 32.
RATE_LIMIT_SECRET=
